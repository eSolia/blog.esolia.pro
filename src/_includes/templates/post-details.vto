<!-- ===== post-details.vto TEMPLATE START ===== -->
<div id="post-details" class="mt-2 flex flex-wrap items-center gap-x-4 text-xs">
  {{ if date !== "hide" }}
    <time
      datetime="{{ date }}"
      class="order-first flex items-center text-zinc-600 dark:text-zinc-300"
    >
      <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-400"></span>
      <span class="ml-3">{{ date |> date("DATE") }}</span>
      {{ if elapsed < 40 }}<img
          class="size-6 fill-sky-400"
          src='{{ "dot-outline" |> icon("phosphor", "duotone") }}'
          inline
        >{{ /if }}
    </time>
  {{ /if }}
  {{ set catColor = featurecats.find((item) => item.key === category)?.color }}
  <a
    href='{{ if lang === "en"}}/en{{/if}}/category/{{ category }}/'
    data-pagefind-filter="{{ i18n.search.filter_by_category }}"
    class="relative rounded-md bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-50 dark:bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-200 px-2 py-1 text-xs font-medium text-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-900 dark:text-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-900 ring-1 ring-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-500/10 dark:ring-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-500/30 ring-inset hover:bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-100 no-underline"
  >{{ category }}</a>
  {{ if author }}
    {{ set page = search.page(`type=author lang=${lang} author="${author}"`) }}
    {{ if page }}
      <span
        class="relative px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700"
      >{{ i18n.post.by }}: <a
          class="no-underline text-zinc-600 dark:text-zinc-300"
          data-pagefind-filter="{{ i18n.search.filter_by_author }}"
          href="{{ page.url }}"
        >{{ author }}</a></span>
    {{ else }}
      <span
        class="relative px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300"
      >{{ i18n.post.by }} {{ author }}</span>
    {{ /if }}
  {{ /if }}
  {{ if readingInfo !== "hide" }}
    <span
      class="relative px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300"
    >{{ i18n.post.reading_time }}: <span class="font-medium">{{ it.readingInfo.minutes }}{{ if lang === "en" }}&nbsp;{{ /if }}{{ i18n.post.minutes }}</span></span>
  {{ /if }}
  {{ if hot }}<span
      class="relative rounded-md px-2 py-1 text-[0.6rem] font-medium bg-esoliaamber-500 ring-1 ring-esoliaamber-900/30 ring-inset text-esoliaamber-950"
    >
      {{ i18n.post.hot }}
    </span>{{ /if }}
</div>
<div class="text-xs/3 text-zinc-500 ml-4 mt-2 flex flex-wrap gap-2 break-keep">
  {{ for tag of tags }}
    {{ set page = search.page(`type=tag lang=${lang} tag="${tag}"`) }}
    {{ if page }}
      <a
        data-pagefind-filter="{{ i18n.search.filter_by_tag }}"
        class="relative rounded-md bg-zinc-50 px-2 py-1 text-xs font-medium text-zinc-600 ring-1 ring-zinc-500/10 ring-inset hover:bg-zinc-100 no-underline"
        href="{{ page.url }}"
      >{{ tag }}</a>
    {{ /if }}
  {{ /for }}
</div>
{{# Photo credit for the post's image.

    Rendered here, with the rest of the post meta, because the image itself is
    not shown on the post page — `image` is the Open Graph card and `image_top`
    is the index thumbnail, so there is no picture to caption. The credit still
    has to appear somewhere the reader can see it, and this is where the other
    provenance lives.

    Every part is optional. A name alone renders as plain text; add a url and
    it becomes a link; add a source and it reads "Photo by X on Unsplash".
    That way an author who only knows half the details can still record what
    they know instead of leaving the field blank. #}}
{{ if image_credit && image_credit.name }}
  <div class="mt-2 text-xs font-extralight text-zinc-500 dark:text-zinc-400">
    {{ i18n.post.photo_credit }}
    {{ if image_credit.url }}
      <a
        href="{{ image_credit.url }}"
        target="_blank"
        rel="noopener"
        class="underline decoration-1"
      >{{ image_credit.name }}</a>
    {{ else }}
      {{ image_credit.name }}
    {{ /if }}
    {{ if image_credit.source }}
      {{ i18n.post.photo_credit_on }}
      {{ if image_credit.source_url }}
        <a
          href="{{ image_credit.source_url }}"
          target="_blank"
          rel="noopener"
          class="underline decoration-1"
        >{{ image_credit.source }}</a>
      {{ else }}
        {{ image_credit.source }}
      {{ /if }}
    {{ /if }}
  </div>
{{ /if }}
<!-- ===== post-details.vto TEMPLATE END ===== -->
