---
layout: layouts/base.vto
bodyClass: body-post
---
<!-- ===== post.vto LAYOUT START ===== -->
<main id="main-content" class="flex-auto">
  <div class="mt-1 lg:mt-8 2xl:mt-10 sm:px-8">
    <div class="mx-auto w-full max-w-7xl lg:px-8">
      <div class="relative px-4 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-2xl lg:max-w-5xl">
          <div class="xl:relative">
            <div class="mx-auto max-w-3xl">
              <div class="hidden md:block">
                <a
                  type="button"
                  href='/{{ if lang === "en"}}en{{/if}}'
                  aria-label="{{ i18n.nav.return_home }}"
                  class="m3-nav-pill group mb-8 flex h-10 w-10 items-center justify-center lg:absolute lg:-left-5 lg:-mt-0 lg:mb-0 xl:-top-0 xl:left-0 xl:-mt-0"
                >
                  <img
                    class="size-5 stroke-zinc-400 transition-all duration-200 ease-m3-spring group-hover:-translate-x-0.5 group-hover:stroke-zinc-700 dark:stroke-zinc-400 dark:group-hover:stroke-zinc-200"
                    src='{{ "arrow-left" |> icon("phosphor", "duotone") }}'
                    inline
                  />
                </a>
              </div>
              <article
                id="post"
                data-pagefind-body
                data-title="{{ title }}"
                data-pagefind-index-attrs="data-title"
              >
                {{# A <div>, not <header>: Cloudflare's Markdown for Agents
                    strips every <header> when converting for AI crawlers,
                    which dropped the H1 from the markdown. Inside <main> a
                    <header> is not a landmark, so nothing is lost. #}}
                <div class="flex flex-col -top-4">
                  <h1
                    class="mt-1 text-fluid-title font-semibold tracking-tight text-sky-950 dark:text-zinc-100 subpixel-antialiased"
                  >
                    {{ title }}
                  </h1>
                  <div class="mt-3">
                    {{
                      include "templates/post-details.vto" {
                        elapsed: elapseddays,
                        hideTags: true,
                      }
                    }}
                  </div>
                  {{ if toc.length }}
                    {{ include "templates/page-toc.vto" }}
                  {{ /if }}
                </div>
                {{# The prose size modifiers are mobile-first on purpose. They
                    used to read `sm:prose-sm md:prose-base lg:prose-lg`, which
                    left NO size below 640px — so narrow screens fell back to
                    full `prose`, the largest of the three, and then SHRANK at
                    the sm breakpoint. The h2 ladder ran 24 -> 20 -> 24 -> 30px
                    while the h1 rose smoothly on its clamp, so below 640px the
                    h2 was larger than the h1 it sat under. Keep `prose-sm`
                    unprefixed. #}}
                <div
                  class="prose max-w-[70ch] prose-zinc text-zinc-800 dark:text-zinc-200 prose-sm md:prose-base lg:prose-lg dark:prose-invert prose-a:underline prose-a:decoration-1 prose-a:transition mt-8"
                  data-mdx-content="true"
                >
                  {{ content |> safe }}
                  {{ if footnotes.length }}
                    <aside role="note" class="footnotes">
                      <dl>
                        {{ for note of footnotes }}
                          <div id="{{ note.id }}" class="footnote">
                            <dt>
                              <a href="#{{ note.refId }}">{{ note.label }}</a>
                            </dt>
                            {{# Rendered markdown from this post, trusted like `content`. #}}
                            <dd>{{ note.content |> safe }}</dd>
                          </div>
                        {{ /for }}
                      </dl>
                    </aside>
                  {{ /if }}
                  {{ if cardPreview }}
                    {{ include "templates/social-card-preview.vto" }}
                  {{ /if }}
                  {{ if tags?.length }}
                    <div class="not-prose mt-8">
                      {{ include "templates/post-details.vto" { onlyTags: true } }}
                    </div>
                  {{ /if }}
                  {{ include "templates/post-share.vto" }}
                  {{# {{ include "templates/post-image.vto" }} #}}
                  {{# <nav class="page-pagination pagination">
                  <ul>
                    {{- set previousPost = search.previousPage(url, "type=post") }}
                    {{- if previousPost }}
                    <li class="pagination-prev">
                      <a href="{{ previousPost.url }}" rel="prev">
                        <span>{{ i18n.nav.previous_post }}</span>
                        <strong>{{ previousPost.title }}</strong>
                      </a>
                    </li>
                    {{ /if }}

                    {{- set nextPost = search.nextPage(url, "type=post") }}
                    {{- if nextPost }}
                    <li class="pagination-next">
                      <a href="{{ nextPost.url }}" rel="next">
                        <span>{{ i18n.nav.next_post }}</span>
                        <strong>{{ nextPost.title }}</strong>
                      </a>
                    </li>
                    {{ /if }}
                  </ul>
                </nav> #}}
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<!-- ===== post.vto LAYOUT END ===== -->
