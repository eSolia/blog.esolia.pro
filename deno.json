{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@v3.3.1/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.15.9/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "hibana/": "https://deno.land/x/hibana@v1.3.0/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "build:cloudflare": "deno task lume",
    "serve": "deno task lume -s",
    "update-deps": "deno run -A --quiet 'https://deno.land/x/nudd@v0.2.8/cli.ts' update deno.json _config.ts",
    "cms": "LUME_CMS=true deno task lume -s",
    "test": "deno test tests/",
    "check:robots": "deno run --allow-net --allow-read scripts/check-robots-sync.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "lint": {
    "exclude": [
      "./_site",
      "./archive"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-import-prefix"
      ]
    },
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@v3.3.1/lint.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "./_site",
      "./archive",
      "./src/_components",
      "./src/posts",
      "./src/_data/authors.yml",
      "./src/_data/featurecats.yml",
      "./src/_data/featuretags.yml",
      "./src/_data/en/featurecats.yml",
      "./src/_data/en/featuretags.yml",
      "./src/uploads",
      "./src/assets",
      "./src/keep-archive",
      "./src/favicon.svg",
      "./README.md",
      "./src/_includes/css/typography.css",
      "./src/_includes/templates/page-toc.vto",
      "./src/_includes/templates/top-nav.vto"
    ]
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ]
}
