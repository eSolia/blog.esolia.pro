<!-- ===== post-list.vto TEMPLATE START ===== -->
{{ for post of postslist }}
  {{# `flex flex-col` below md so the photo can lead with `order-first`;
      block layout would ignore order and leave it under the excerpt. The
      photo keeps `order-first` at md too, which is what places it in the grid
      cell the date used to hold. `items-start`, not the old `items-baseline`
      that aligned the date text: an image's baseline is its bottom edge,
      which drops the text column half a card down. #}}
  {{# `group relative` lives on the row, not on the text column: the hover
      panel and the title's stretched link are absolutely positioned, so they
      size to this element, and hovering the photo highlights the row too. #}}
  <article
  id="post-list"
  class="group relative flex flex-col gap-4 md:grid md:grid-cols-4 md:items-start md:gap-6"
>
  <div class="flex flex-col items-start md:col-span-3">
      <h2
        class="text-base font-semibold tracking-tight text-zinc-950 dark:text-zinc-100"
      >
        <div
          class="absolute -inset-x-4 -inset-y-6 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:-inset-x-6 sm:rounded-2xl dark:bg-zinc-800/50"
        >
        </div>
        <a
          href="{{ post.url }}"
          data-faid="{{ post.lang }}-{{ if post.id.length > 0 }}{{ post.id }}{{ else }}{{ loop.index }}{{ /if }}"
          class="data-fatrigger"
          {{ if post.url == url }}
            aria-current="page"{{ /if }}
        ><span
            class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl"
          ></span><span class="relative inline-block z-10">
            <span class="">{{ post.title || post.url }}</span>
            {{ if post.hot }}<span
                class="absolute top-0 -right-2 bg-esoliaamber-500 text-white text-[0.6rem] font-semibold ml-4 px-2 py-1 rounded-full transform translate-x-1/2 -translate-y-1/2 rotate-12"
              >
                {{ i18n.post.hot }}
              </span>{{ /if }}
          </span>
        </a>
      </h2>
      <div
        class="relative z-10 mt-2 text-sm/7 text-zinc-600 dark:text-zinc-200 truncate w-full"
      >
        {{# Rendered markdown, trusted like the post body it is cut from. #}}
        {{ post.excerpt |> md(true) |> safe }}
      </div>

      {{
        include "templates/post-details.vto" {
          date: post.date,
          elapsed: post.elapseddays,
          category: post.category,
          author: post.author,
          readingInfo: post.readingInfo,
        }
      }}
      <div
        aria-hidden="true"
        class="relative z-10 mt-4 flex items-center text-sm font-medium text-sky-500"
      >
        {{ i18n.nav.continue_reading }}<img
          alt=""
          loading="lazy"
          decoding="async"
          class="h-4 w-4 fill-sky-500 dark:fill-sky-300"
          src='{{ "caret-right" |> icon("phosphor") }}'
          inline
        >
      </div>
    </div>
  {{# The photo, in the column the date used to occupy, and first in reading
      order on small screens. It carries no link of its own: the title's
      stretched link covers the whole row, photo included, so a second link to
      the same post would only compete with it. Decorative for assistive tech
      (`alt=""`, `aria-hidden`), since the title already names the post.

      The wrapper is load-bearing: `picture()` wraps this `<img>` in a
      `<picture>`, so the *wrapper* is the grid item and ordering classes on
      the `<img>` place nothing. `[&>picture]:block` blockifies the generated
      element, which is otherwise inline and adds a descender gap.

      `relative z-10` keeps the photo above the row's hover panel, which is
      positioned at `z-0` and would otherwise wash over it. #}}
  <div class="relative z-10 order-first md:mt-1 [&>picture]:block">
    <img
      src="{{ if post.image_top }}{{ post.image_top }}{{ else }}/assets/blog-esolia-pro-default-top.png{{ /if }}"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="320"
      height="180"
      class="aspect-video w-full rounded-xl object-cover ring-1 ring-zinc-900/10 dark:ring-white/10 dark:mix-blend-luminosity"
      transform-images="avif webp jpeg 320@2 480@2"
      sizes="(max-width: 767px) 100vw, 320px"
    >
  </div>
</article>
{{ /for }}
<!-- ===== post-list.vto TEMPLATE END ===== -->
