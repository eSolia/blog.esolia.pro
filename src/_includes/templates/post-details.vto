<!-- ===== post-details.vto TEMPLATE START ===== -->
{{# The links in this row carry `z-30`. In the archive and category lists the
    post title stretches an `absolute z-20` link across the whole row, which
    sat on top of them: clicking a category pill, author or tag navigated to
    the post instead. Raising only the links keeps the gaps between them part
    of the post's click target. #}}
{{ if !onlyTags }}
<div id="post-details"
  class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
  {{ if date !== "hide" }}
    {{# ISO in the attribute, localized text for readers: `date` is a Date, so
        interpolating it raw emitted "Tue Sep 22 2026 09:00:00 GMT+0900
        (日本標準時)", which is not a valid datetime value. #}}
    <time
      datetime="{{ date |> date("ATOM") }}"
      {{# `relative`, like every other item in this row: in the archive list a
          hover panel sits behind the row at `z-0`, and an unpositioned child
          paints below it — the date vanished on hover. #}}
      class="relative order-first flex items-center text-zinc-600 dark:text-zinc-300"
    >
      <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-400"></span>
      <span class="ml-3">{{ date |> date("DATE") }}</span>
      {{ if elapsed < 40 }}<img
          class="size-6 fill-sky-400"
          src='{{ "dot-outline" |> icon("phosphor", "duotone") }}'
          inline
        >{{ /if }}
    </time>
  {{ /if }}
  {{ set catColor = featurecats.find((item) => item.key === category)?.color }}
  <a
    href='{{ if lang === "en"}}/en{{/if}}/category/{{ category }}/'
    data-pagefind-filter="{{ i18n.search.filter_by_category }}"
    class="m3-chip relative z-30 inline-flex min-h-7 items-center bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-50 dark:bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-200 px-3 py-1 text-xs font-medium text-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-900 dark:text-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-900 ring-1 ring-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-500/15 dark:ring-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-500/30 ring-inset hover:bg-{{ if catColor }}{{ catColor }}{{ else }}zinc{{ /if }}-100 no-underline"
  >{{ category }}</a>
  {{ if author }}
    {{ set page = search.page(`type=author lang=${lang} author="${author}"`) }}
    {{ if page }}
      <span
        class="relative z-30 rounded-md px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800"
      >{{ i18n.post.by }}: <a
          class="no-underline text-zinc-600 hover:text-sky-700 dark:text-zinc-300 dark:hover:text-sky-300"
          data-pagefind-filter="{{ i18n.search.filter_by_author }}"
          href="{{ page.url }}"
        >{{ author }}</a></span>
    {{ else }}
      <span
        class="relative px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300"
      >{{ i18n.post.by }} {{ author }}</span>
    {{ /if }}
  {{ /if }}
  {{ if readingInfo !== "hide" }}
    <span
      class="relative px-2 py-1 text-xs font-extralight text-zinc-600 dark:text-zinc-300"
    >{{ i18n.post.reading_time }}: <span class="font-medium">{{ it.readingInfo.minutes }}{{ if lang === "en" }}&nbsp;{{ /if }}{{ i18n.post.minutes }}</span></span>
  {{ /if }}
  {{ if hot }}<span
      class="relative rounded-full px-2.5 py-0.5 text-[0.65rem] font-medium bg-esoliaamber-500 ring-1 ring-esoliaamber-900/30 ring-inset text-esoliaamber-950"
    >
      {{ i18n.post.hot }}
    </span>{{ /if }}
</div>
{{ /if }}
{{ if !hideTags && tags?.length }}
<div
  class="text-xs/3 text-zinc-500 {{ if onlyTags }}mt-0{{ else }}ml-4 mt-2{{ /if }} flex flex-wrap gap-2 break-keep">
  {{ for tag of tags }}
    {{ set page = search.page(`type=tag lang=${lang} tag="${tag}"`) }}
    {{ if page }}
      <a
        data-pagefind-filter="{{ i18n.search.filter_by_tag }}"
        class="m3-chip relative z-30 inline-flex min-h-7 items-center border border-outline-variant bg-surface-container-low px-3 py-1 text-xs font-medium text-zinc-700 hover:bg-surface-container dark:text-zinc-200 no-underline"
        href="{{ page.url }}"
      >{{ tag }}</a>
    {{ /if }}
  {{ /for }}
</div>
{{ /if }}
{{# No photo credit here, deliberately.

    The post page never shows the credited photo: `image` is the Open Graph
    card and `image_top` the index thumbnail. A visible "Photo: X on Unsplash"
    therefore credited an image the reader could not see, sitting next to
    screenshots they could — and they naturally read it as crediting one of
    those.

    The rule now is: show a credit only where its photo is visible. Index cards
    display the photo, so top-post-cards1.vto keeps the overlay credit. Here the
    credit lives in metadata instead — `image_credit` in frontmatter, carried
    into JSON-LD as a schema.org ImageObject by a processor in _config.ts. #}}
<!-- ===== post-details.vto TEMPLATE END ===== -->
