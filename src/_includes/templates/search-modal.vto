<!-- ===== search-modal.vto TEMPLATE START ===== -->
{{# role/aria-modal tell assistive tech this is a dialog and that the page
    behind it is inert while it is open. The JS in main.js flips aria-hidden
    and traps Tab inside; neither works without the element being announced as
    a dialog in the first place. #}}
<div
  id="searchModal"
  class="invisible hidden fixed inset-0 z-1000 w-full h-full overflow-y-auto bg-esoliablue-950/45 dark:bg-black/65 opacity-0 backdrop-blur-[3px] transition-opacity duration-200 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="{{ i18n.search.dialog_label }}"
  aria-hidden="true"
>
  <div
    data-search-panel
    class="relative w-full max-w-2xl max-h-[80vh] mx-auto mt-[10vh] overflow-y-auto p-5 sm:p-6 bg-surface-container-low border border-outline-variant rounded-3xl shadow-2xl scale-95 opacity-0 transition-all duration-240 ease-m3-emphasized-decelerate"
  >
    <div
      class="flex items-center justify-between border-b border-outline-variant pb-3 mb-4">
      <span class="text-sm font-semibold text-zinc-700 dark:text-zinc-200">{{ i18n.search.dialog_label }}</span>
      {{# A button, not <a href="#">: closing a dialog is an action, not a
          navigation. The anchor also jumped the page to the top and appended
          "#" to the URL on every close. #}}
      <button
        id="modal-close"
        type="button"
        class="m3-chip cursor-pointer border border-outline-variant bg-surface-container px-3 py-1 text-xs font-medium text-zinc-700 hover:bg-surface-container-high dark:text-zinc-200"
      >
        {{ i18n.search.close_link }}
      </button>
    </div>
    <div id="search" class="text-left" tabindex="0"></div>
  </div>
</div>
<!-- ===== search-modal.vto TEMPLATE END ===== -->
