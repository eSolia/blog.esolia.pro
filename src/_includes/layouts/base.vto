<!DOCTYPE html>
<!-- ===== base.vto LAYOUT START ===== -->

<html lang="{{ it.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title |> plaintext }} - {{ site.title }}</title>

    <meta name="supported-color-schemes" content="light dark">
    <meta
      name="theme-color"
      content="hsl(33.38 100% 70%)"
      media="(prefers-color-scheme: light)"
    >
    <meta
      name="theme-color"
      content="hsl(200, 98%, 39%)"
      media="(prefers-color-scheme: dark)"
    >

    {{ include "templates/cdn-preconnect.vto" }}

    {{ if lang === "ja" }}{{- include "templates/font-preload-ja.vto" -}}{{
      /if
    }}
    {{ if lang === "en" }}{{- include "templates/font-preload-en.vto" -}}{{
      /if
    }}

    <link
      rel="preload"
      href="/fonts-{{ lang }}.css?cb={{ cacheBuster }}"
      as="style"
    >
    <link
      rel="stylesheet"
      href="/fonts-{{ lang }}.css?cb={{ cacheBuster }}"
      type="text/css"
    >
    <link
      rel="stylesheet"
      href="/styles.css?cb={{ cacheBuster }}"
      type="text/css"
    >
    <link
      rel="alternate"
      href="/feed.{{ it.lang }}.xml"
      type="application/atom+xml"
      title="{{ site.title }}"
    >
    <link
      rel="alternate"
      href="/feed.{{ it.lang }}.json"
      type="application/json"
      title="{{ site.title }}"
    >
    <link rel="canonical" href="{{ url |> url(true) }}">
    <link rel="self" href="{{ url |> url(true) }}">
    <link rel="hub" href="https://pubsubhubbub.appspot.com/">

    {{# Various js, such as Alpine and Fathom and the theme toggle script #}}
    <script src="/js/main.js?cb={{ cacheBuster }}" type="module" defer></script>
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials">
    {{# {{ it.extra_head?.join("\n") }} #}}
  </head>
  <body class="flex h-full bg-zinc-50 dark:bg-black">
    {{ include "templates/skiplink.vto" }}
    <!-- Container start -->
    <div class="flex w-full">
      {{# This fixed layer spans the whole viewport; the white sheet below only
          covers the middle of it. So a texture painted here shows ONLY in the
          left and right gutters — the sheet is opaque and hides the rest. No
          extra elements, and nothing to keep in sync with the sheet's width. #}}
      <div class="page-gutters fixed inset-0 flex justify-center sm:px-8">
        <div class="flex w-full max-w-7xl lg:px-8">
          {{# This empty sheet is the white page panel. It is a fixed backdrop
              behind all content, which is why selecting divs in the content
              tree never highlights it.

              The home page's circuit underlay lives here rather than in the
              hero, because this is the box whose top-right corner it should
              start from. Being in the backdrop also means it paints behind
              everything without any z-index wrangling — the content column is
              a later sibling of this whole fixed layer. #}}
          <div
            class="relative overflow-hidden w-full bg-white ring-1 ring-zinc-100 dark:bg-zinc-900 dark:ring-zinc-300/20"
          >
            {{ if id == "home" }}
              {{ include "templates/hero-circuit.vto" }}
            {{ /if }}
          </div>
        </div>
      </div>
      <div class="relative flex w-full flex-col">
        {{ include "templates/top-nav.vto" }}
        <div class="flex-none" style="height: var(--content-offset)"></div>

        {{ content }}

        <!-- Current page: {{ url }} -->
        {{ include "templates/footer.vto" }}
        {{ include "templates/search-modal.vto" }}
      </div>
    </div>
    <!-- Container end -->
    <script src="{{ script }}"></script>
  </body>
  <!-- ===== base.vto LAYOUT END ===== -->
</html>
