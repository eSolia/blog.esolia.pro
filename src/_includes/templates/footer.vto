<!-- ===== footer.vto TEMPLATE START ===== -->
{{# Matches esolia-2025 Footer.svelte: one notch deeper than sky-950 so the
    footer sits on the shared eSolia sky-navy ramp across both sites. #}}
<footer
  id="footer"
  class="relative z-10 mt-32 flex-none bg-[oklch(0.195_0.042_245)] dark:bg-[oklch(0.195_0.042_245)]"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="py-16">
      <a
        aria-label="{{ i18n.nav.return_home }}"
        class="pointer-events-auto block origin-left"
        href='/{{ if lang === "en" }}{{ lang }}/{{ /if }}'
      ><img
          alt="{{ i18n.nav.logo_large_alt }}"
          loading="lazy"
          fetchpriority="auto"
          decoding="async"
          class="mx-auto h-12 w-auto object-contain transition-opacity duration-300 hover:opacity-80"
          src="/assets/logo_horiz_white_bgtransparent.svg"
          height="111"
          width="454"
        /></a>

      <nav class="mt-10 text-sm" aria-label="{{ i18n.nav.footer_nav_label }}">
        <div class="-my-1 flex justify-center gap-x-6 gap-y-2 flex-wrap">
          {{- for item of it.footernav.links }}
            {{# The icon comes from the same `icon:` field the drawer uses, so
                the two navigations look related. The field had been on this
                data for a long time without ever being rendered, which is how
                two names that do not exist in Phosphor (`privacy`, `sitemap`)
                sat here unnoticed — nothing ever asked for them. #}}
            <a
              class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-sm text-white hover:text-esoliaamber-400 dark:text-white dark:hover:text-esoliaamber-400 no-underline transition-colors {{- if item.target === '_blank' }} after:content-['_↗']{{ /if -}}"
              href="{{ item.href }}"
              title="{{ item.title }}"
              {{- if item.target }}target="{{ item.target }}"{{ /if }}
              {{- if item.target === "_blank" }}rel="noopener"{{ /if -}}
            >
              {{ if item.icon }}<img
                  class="h-4 w-4 shrink-0 fill-white/70"
                  src='{{ item.icon |> icon("phosphor", "duotone") }}'
                  alt=""
                  aria-hidden="true"
                  inline
                />{{ /if }}
              {{ item.text }}
              {{ if item.target === "_blank" }}<span class="sr-only">
                  ({{ i18n.nav.new_tab }})</span>{{ /if }}</a>
          {{ /for -}}
        </div>
      </nav>
    </div>
    <div
      class="flex flex-col items-center border-t border-white/20 py-10 sm:flex-row-reverse sm:justify-between no-external-icon"
    >
      <div class="mt-6 flex flex-wrap gap-6 sm:mt-0">
        <a
          class="group -m-1 p-1"
          aria-label="{{ i18n.social.linkedin_label }}"
          href="{{ i18n.social.linkedin_profile_url }}"
          target="_blank"
          rel="noopener"
        ><img
            class="h-6 w-6 fill-blue-200 transition hover:scale-110"
            src='{{ "linkedin-logo" |> icon("phosphor", "duotone") }}'
            inline
          ></a>
        <a
          class="group -m-1 p-1"
          aria-label="{{ i18n.social.bluesky_label }}"
          href="{{ i18n.social.bluesky_profile_url }}"
          target="_blank"
          rel="noopener"
        ><img
            class="h-6 w-6 fill-sky-400 transition hover:scale-110"
            src='{{ "butterfly" |> icon("phosphor", "duotone") }}'
            inline
          ></a>
        <a
          class="group -m-1 p-1"
          aria-label="{{ i18n.social.twitter_label }}"
          href="{{ i18n.social.twitter_profile_url }}"
          target="_blank"
          rel="noopener"
        ><img
            class="h-6 w-6 fill-white/85 transition hover:scale-110"
            src='{{ "x-logo" |> icon("phosphor", "duotone") }}'
            inline
          ></a>
        <a
          class="group -m-1 p-1"
          aria-label="{{ i18n.social.github_label }}"
          href="{{ i18n.social.github_profile_url }}"
          target="_blank"
          rel="noopener"
        ><img
            class="h-6 w-6 fill-green-400 transition hover:scale-110"
            src='{{ "github-logo" |> icon("phosphor", "duotone") }}'
            inline
          ></a>
      </div>
      <p
        class="mt-6 text-sm text-white sm:mt-0 text-center sm:text-left"
      >
        ©{{ new Date().getFullYear() }}
        {{ i18n.home.company_long }} All rights reserved.<br>
        <span class="text-xs text-white/80">{{ i18n.home.company_address }}</span>
      </p>
    </div>
  </div>
</footer>
<!-- ===== footer.vto TEMPLATE END ===== -->
