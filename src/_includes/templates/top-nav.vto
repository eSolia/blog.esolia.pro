<!-- ===== top-nav.vto TEMPLATE START ===== -->
<header id="top-nav" class="pointer-events-none relative z-50 flex flex-none flex-col">
  <div class="order-last mt-[calc(--spacing(16)-(--spacing(3)))]"></div>
  <div class="top-0 order-last -mb-3 pt-3 sm:px-8">
    <div class="mx-auto w-full max-w-7xl lg:px-8">
      <div class="relative px-4 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-2xl lg:max-w-5xl">
          <div class="top-(--avatar-top,--spacing(3)) w-full">
            {{# Pulled up and left toward the sheet's corner. The circuit
                underlay anchors the top-right, so a larger mark here gives the
                composition two corner anchors with the headline in the
                diagonal between them. It also makes the scroll swap read as
                intentional: this symbol shrinks into the nav symbol at
                roughly the same place, instead of a wordmark dissolving and a
                symbol appearing somewhere else. #}}
            {{# Category pages carry the mark inside their own hero band, so
                showing this one too would put two eSolia symbols on the page
                within a few hundred pixels of each other. #}}
            <div
              class="relative mt-12 md:mt-1 md:-ml-20{{ if type === "category" || type === "tag" }} hidden{{ /if }}"
            >
              <a
                aria-label="{{ i18n.nav.return_home }}"
                type="button"
                class="pointer-events-auto block origin-left"
                href="/{{ if it.lang === "en"}}{{ it.lang }}/{{ /if }}"
              ><img
                  id="large-logo"
                  alt="{{ i18n.nav.logo_large_alt}}"
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                  {{# Grey on the home page, full colour on posts.

                      The home page carries the circuit underlay, the gutter
                      texture and the shared masthead ink, so a coloured mark
                      there would be the one loud thing in a quiet
                      composition. A post page has none of that decoration, so
                      the colour is what keeps the top of the page from
                      reading as bare.

                      The two need different assets, not just a different
                      tint: the brand mark is two-tone (#2D2F63 with one
                      #FFBC68 leaf), and the currentColor version flattens to
                      a single colour by design. Only the grey one is inlined,
                      since only it needs CSS tinting. #}}
                  class="hero-symbol {{ if bodyClass === "body-post" }}hero-symbol--brand hero-symbol--light {{ /if }}w-28 md:w-44 hidden md:block"
                  src="{{ if bodyClass === "body-post" }}/assets/symbol_darkblue_bgtransparent_2.svg{{ else }}/assets/symbol_currentcolor.svg{{ /if }}"
                  height="170"
                  width="170"
                  {{ if bodyClass !== "body-post" }}inline{{ /if }}
                />{{ if bodyClass === "body-post" }}{{# The dark-mode twin of the
                  mark above: the same artwork drawn in white, since the
                  two-tone brand version goes muddy on a dark background.
                  Decorative, because the image above already carries the link
                  text for assistive technology. #}}<img
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                  class="hero-symbol hero-symbol--brand hero-symbol--dark w-28 md:w-44 hidden"
                  src="/assets/symbol_white_bgtransparent.svg"
                  height="170"
                  width="170"
                />{{ /if }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    id="top-nav-bg"
    class="fixed top-0 z-10 h-20 pt-6 w-full bg-zinc-50/50 dark:bg-zinc-700/50 transition-all duration-700 backdrop-blur shadow-xs"
  >
    <div class="top-(--header-top,--spacing(6)) w-full sm:px-8 fixed">
      <div class="mx-auto w-full max-w-7xl lg:px-8">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <div class="relative flex gap-4 items-center">
              <div class="flex flex-1 items-center">
                <a
                  aria-label="{{ i18n.nav.return_home }}"
                  class="pointer-events-auto block origin-left"
                  href="/{{ if it.lang === "en"}}{{ it.lang }}/{{ /if }}"
                  type="button"
                ><img
                    id="small-logo"
                    alt="{{ i18n.nav.logo_symbol_alt }}"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                    class="w-12 object-cover rounded-md bg-white/90 dark:bg-white/10 dark:grayscale dark:invert dark:saturate-[.1] transition-opacity duration-300 block opacity-100 md:opacity-0"
                    src="/assets/symbol_darkblue_bgtransparent_2.svg"
                    height="170"
                    width="170"
                  /></a>
              </div>
              <div class="flex flex-1 justify-end lg:justify-center">
                <div class="pointer-events-auto lg:hidden relative">
                  <button
                    class="group flex items-center rounded-full bg-white/90 px-4 py-2 text-sm whitespace-nowrap font-medium text-zinc-950 ring-1 shadow-lg shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10 dark:hover:ring-white/20"
                    type="button"
                    {{# aria-expanded starts false for the server-rendered
                        state and is kept in step by the drawer's menu-state
                        event; aria-controls points at the panel so assistive
                        technology can follow the relationship. #}}
                    aria-expanded="false"
                    aria-controls="mobile-menu-panel"
                    x-data="{ open: false }"
                    @menu-state.window="open = $event.detail.open"
                    :aria-expanded="open ? 'true' : 'false'"
                    @click="$dispatch('toggle-menu')"
                  >
                    <span>{{ i18n.nav.mobile_nav_name }}</span>
                    <svg
                      viewBox="0 0 8 6"
                      aria-hidden="true"
                      class="ml-3 h-auto w-2 stroke-zinc-500 group-hover:stroke-zinc-700 dark:group-hover:stroke-zinc-400"
                    >
                      <path
                        d="M1.75 1.75 4 4.25l2.25-2.5"
                        fill="none"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                      </path>
                    </svg>
                  </button>
                </div>
                <div
                  hidden=""
                  style="position: fixed; top: 1px; left: 1px; width: 1px; height: 0; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0; display: none"
                >
                </div>

              </div>
              <div class="flex justify-end lg:flex-1 z-50 space-x-1">
                {{# Link out to the corporate site. An <a>, not a <button>, so
                    it behaves like a link (middle-click, open in new tab). The
                    href is absolute by necessity: base_path rewrites anything
                    root-relative to /blog/*, and this needs to leave the blog. #}}
                {{# Hidden below lg: at those widths this lives in the
                    drawer instead, so the control row does not overflow. #}}
                <div class="pointer-events-auto z-50 relative group hidden lg:block">
                  <a
                    href="{{ i18n.mainsite.url }}"
                    aria-label="{{ i18n.mainsite.label }}"
                    class="group block rounded-full bg-white/90 px-3 py-2 ring-1 shadow-lg shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20 z-50"
                  >
                    <span>
                      <img
                        class="h-5 w-5 fill-sky-500 stroke-sky-800 dark:fill-sky-300 dark:stroke-sky-500 transition group-hover:fill-sky-600 group-hover:stroke-sky-900 dark:group-hover:fill-sky-400 dark:group-hover:stroke-sky-600 hover:scale-110"
                        src='{{ "buildings" |> icon("phosphor", "duotone") }}'
                        alt=""
                        aria-hidden="true"
                        inline
                      />
                    </span>
                  </a>
                  <div
                    class="absolute top-full left-1/2 transform -translate-x-1/2 mt-2 px-2 py-1 bg-zinc-200 text-zinc-950 dark:bg-zinc-700 dark:text-zinc-200 text-sm rounded-md opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none z-50 whitespace-nowrap before:content-[''] before:absolute before:bottom-full before:left-1/2 before:transform before:-translate-x-1/2 before:border-8 before:border-x-transparent before:border-t-0 before:border-b-zinc-200 dark:before:border-b-zinc-700"
                  >
                    {{ i18n.mainsite.tooltip }}
                  </div>
                </div>
                <div
                  class="pointer-events-auto z-50 relative group"
                >
                  <button
                    type="button"
                    id="search-button" 
                    aria-label="{{ i18n.search.open_search }}"
                    class="group rounded-full bg-white/90 px-3 py-2 ring-1 shadow-lg shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20 z-50"
                  >
                    <span>
                      <img
                        class="h-5 w-5 fill-sky-500 stroke-sky-800 dark:fill-sky-300 dark:stroke-sky-500 transition group-hover:fill-sky-600 group-hover:stroke-sky-900 dark:group-hover:fill-sky-400 dark:group-hover:stroke-sky-600 transition hover:scale-110"
                        src='{{ "magnifying-glass" |> icon("phosphor", "duotone") }}'
                        inline
                      />
                    </span>
                  </button>
                  <div
                    class="absolute top-full left-1/2 transform -translate-x-1/2 mt-2 px-2 py-1 bg-zinc-200 text-zinc-950 dark:bg-zinc-700 dark:text-zinc-200  text-sm rounded-md opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 pointer-events-none z-50 whitespace-nowrap before:content-[''] before:absolute before:bottom-full before:left-1/2 before:transform before:-translate-x-1/2 before:border-8 before:border-x-transparent before:border-t-0 before:border-b-zinc-200 dark:before:border-b-zinc-700"
                  >
                    {{ i18n.search.tooltip |> safe }}{{# site-authored i18n; contains <kbd> and <br> by design #}}
                  </div>
                </div>
                <div
                  class="pointer-events-auto z-50 hidden lg:block"
                  x-data="themeToggle"
                  :class="{ 'dark': darkMode }"
                >
                  <button
                    type="button"
                    aria-label="{{ i18n.nav.toggle_theme }}"
                    class="group rounded-full bg-white/90 px-3 py-2 ring-1 shadow-lg shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20 z-50"
                    @click="toggleTheme()"
                  >
                    <span x-show="!darkMode">
                      <img
                        class="h-5 w-5 fill-esoliaamber-500 stroke-esoliaamber-800 transition group-hover:fill-sky-400 group-hover:stroke-sky-600 transition hover:scale-110"
                        src='{{ "sun" |> icon("phosphor", "duotone") }}'
                        inline
                      />
                    </span>
                    <span x-show="darkMode">
                      <img
                        class="h-5 w-5 fill-sky-300 stroke-sky-500 transition group-hover:fill-esoliaamber-600 group-hover:stroke-esoliaamber-900 transition hover:scale-110"
                        src='{{ "moon-stars" |> icon("phosphor", "duotone") }}'
                        inline
                      />
                    </span>
                  </button>
                </div>
                {{# Last in the row on purpose: this is the only wide pill among
                    round icon buttons, and mid-group it read as an odd lump
                    between them. At the end it anchors the row instead. #}}
                {{ if alternates && alternates.length > 1 }}
                  {{# The language switch is a link, not a button: it navigates.
                      It used to be an <a> nested inside a <button>, which axe
                      flags as nested-interactive (serious) — two focusable
                      controls in one place, with assistive tech announcing a
                      button that is really a link. The <a> now carries the
                      styling directly. hreflang and lang let a screen reader
                      switch voice for the target language. #}}
                  <div class="pointer-events-auto z-50 hidden lg:block">
                    {{- for alt of alternates }}{{ if alt.lang !== lang }}
                        <a
                          class="group relative block rounded-full bg-sky-800/95 px-3 py-2 ring-1 shadow-lg shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20 z-50 text-sm font-medium text-zinc-50 dark:text-zinc-200 hover:text-esoliaamber-400 dark:hover:text-esoliaamber-500"
                          href="{{ alt.url }}"
                          hreflang="{{ alt.lang }}"
                          lang="{{ alt.lang }}"
                          {{# No `|> escape` here: autoescape is on, and an explicit
                              escape on top of it double-escapes — a title with "&"
                              showed "&amp;" in the tooltip. #}}
                          title="{{ alt.title }}"
                        >{{ if alt.lang == "ja" }}日本語{{ else }}English{{
                          /if
                        }}<span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-zinc-500/0 via-zinc-500/40 to-zinc-500/0 dark:from-zinc-400/0 dark:via-zinc-400/40 dark:to-zinc-400/0 opacity-0 group-hover:opacity-100 transition duration-300"></span></a>
                      {{ /if }}{{ /for }}
                  </div>
                {{ /if }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{# Outside #top-nav-bg deliberately. That element carries
      `backdrop-blur`, and backdrop-filter creates a containing block for
      fixed-position descendants just as transform does — so a drawer
      nested inside it resolved `inset-y-0` against the 80px nav bar and
      rendered 80px tall instead of full height. #}}
  {{# Drawer navigation for narrow viewports.

      Shown below `lg`, not below `md`. The control row to the
      right holds four items, and at the md breakpoint (768px)
      they stop fitting — the language pill wrapped onto two
      lines. Switching over at lg removes that cramped band
      entirely rather than shaving pixels off the pill.

      The main-site link, the theme toggle and the language
      switch all live inside the drawer at these sizes. Search
      deliberately stays outside as its own button: it is a
      primary action on a blog, and putting it two taps away
      would be a regression. #}}
  <div
    class="pointer-events-auto lg:hidden"
    x-data="mobileMenu"
    @toggle-menu.window="toggle()"
    @keydown.escape.window="close()"
    @keydown.tab="trapFocus($event)"
  >
    {{# Backdrop. Click to dismiss; inert to screen readers. #}}
    <div
      x-show="open"
      x-cloak
      x-transition.opacity
      class="fixed inset-0 z-90 bg-zinc-900/40 backdrop-blur-xs"
      aria-hidden="true"
      @click="close()"
    >
    </div>

    <div
      x-show="open"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="fixed inset-y-0 right-0 z-100 flex w-72 max-w-[85vw] flex-col bg-white shadow-xl dark:bg-zinc-900"
      role="dialog"
      aria-modal="true"
      aria-label="{{ i18n.nav.mobile_nav_name }}"
      id="mobile-menu-panel"
      x-ref="panel"
    >
      <div
        class="flex items-center justify-between border-b border-zinc-200 px-4 py-3 dark:border-zinc-700"
      >
        <span
          class="text-sm font-medium text-zinc-600 dark:text-zinc-300"
        >{{ i18n.nav.mobile_nav_name }}</span>
        <button
          type="button"
          aria-label="{{ i18n.search.close_link }}"
          class="rounded-md p-2 text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          @click="close()"
          x-ref="closeBtn"
        >
          <img
            class="h-5 w-5"
            src='{{ "x" |> icon("phosphor") }}'
            alt=""
            aria-hidden="true"
            inline
          />
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-4 py-4">
        <ul class="space-y-1">
          {{- for item of it.mobilenav.primary }}
            <li>
              <a
                class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800 dark:hover:text-white"
                href="{{ item.href }}"
                {{- if item.target }}target="{{ item.target }}"{{ /if -}}
                {{- if item.target === "_blank" }}rel="noopener"{{ /if -}}
                title="{{ item.title }}"
              >
                <img
                  class="h-5 w-5 shrink-0 fill-sky-500 stroke-sky-800 dark:fill-sky-300 dark:stroke-sky-500"
                  src='{{ item.icon |> icon("phosphor", "duotone") }}'
                  alt=""
                  aria-hidden="true"
                  inline
                />
                {{ item.text }}
                <span class="sr-only">({{ item.aria_label }})</span>
              </a>
            </li>
          {{ /for -}}
        </ul>

        <div
          class="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-700"
        >
          <ul class="space-y-1">
            {{- for item of it.mobilenav.secondary }}
              <li>
                <a
                  class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
                  href="{{ item.href }}"
                  {{- if item.target }}target="{{ item.target }}"{{ /if -}}
                  {{- if item.target === "_blank" }}rel="noopener"{{ /if -}}
                  title="{{ item.title }}"
                >
                  <img
                    class="h-4 w-4 shrink-0"
                    src='{{ item.icon |> icon("phosphor") }}'
                    alt=""
                    aria-hidden="true"
                    inline
                  />
                  {{ item.text }}
                  <span class="sr-only">({{ item.aria_label }})</span>
                </a>
              </li>
            {{ /for -}}
          </ul>
        </div>
      </nav>

      {{# Theme on the left, language on the right, as on the
          main site. #}}
      <div
        class="border-t border-zinc-200 px-4 py-4 dark:border-zinc-700"
      >
        <div class="flex items-center justify-between">
          <button
            type="button"
            x-data="themeToggle"
            @click="toggleTheme()"
            aria-label="{{ i18n.nav.toggle_theme }}"
            class="rounded-md p-2 text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            <img
              class="h-5 w-5 dark:hidden"
              src='{{ "sun" |> icon("phosphor", "duotone") }}'
              alt=""
              aria-hidden="true"
              inline
            />
            <img
              class="hidden h-5 w-5 dark:block"
              src='{{ "moon-stars" |> icon("phosphor", "duotone") }}'
              alt=""
              aria-hidden="true"
              inline
            />
          </button>
          {{ if alternates && alternates.length > 1 }}
            {{- for alt of alternates }}{{ if alt.lang !== lang }}
                <a
                  class="rounded-full bg-sky-800/95 px-3 py-1.5 text-sm text-white ring-1 ring-zinc-900/5 transition hover:bg-sky-700"
                  href="{{ alt.url }}"
                  hreflang="{{ alt.lang }}"
                  lang="{{ alt.lang }}"
                  title="{{ alt.title }}"
                >{{ if alt.lang == "ja" }}日本語{{ else }}English{{ /if }}</a>
              {{ /if }}{{ /for }}
          {{ /if }}
        </div>
      </div>
    </div>
  </div>
</header>
<!-- ===== top-nav.vto TEMPLATE END ===== -->
