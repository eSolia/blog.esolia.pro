---
layout: layouts/base.vto
bodyClass: body-tag
script: /js/fathom-post-list-event.js
---
<!-- ===== archive.vto LAYOUT START ===== -->
<main id="main-content" class="flex-auto">
  <div class="mt-16 sm:mt-32 sm:px-8">
    <div class="mx-auto w-full max-w-full lg:px-8">
      <div class="relative px-4 sm:px-8 lg:px-12">
        <div id="archive" class="mx-auto max-w-2xl lg:max-w-5xl">
          <header class="max-w-2xl">
            <h1
              class="text-2xl 2xs:text-3xl sm:text-4xl lg:text-5xl tracking-tight text-zinc-950 dark:text-zinc-100"
            >
              <span class="font-semibold subpixel-antialiased">{{ site.title }}</span>
              <br class="block md:hidden">
              <span
                class="font-extralight text-esoliablue-900 dark:text-esoliablue-600"
              >{{ i18n.archive.title }}</span>
            </h1>
            <p class="mt-6 text-base text-zinc-950 dark:text-zinc-400">
              {{ i18n.archive.description }}
            </p>

            <div class="flex items-center space-x-2 mt-4">
              <img
                class="size-6 fill-esoliaamber-400"
                src='{{ "rss" |> icon("phosphor", "duotone") }}'
                inline
              >
              <span class="dark:invert">RSS:</span>&nbsp;<a
                class=""
                href="/feed.{{ lang }}.xml"
              >Atom,
              </a>&nbsp;<a
                class=""
                href="/feed.{{ lang }}.json"
              >JSON</a>
            </div>
            {{ if pagination.page === 1 }}
              {{
                set pageCats = search.pages(
                  `type=category lang=${lang}`,
                  "category",
                )
              }}
              {{ if pageCats.length }}
                <div class="text-zinc-500 ml-1 mt-6">
                  <nav class="">
                    <h2>{{ i18n.search.categories }}:</h2>
                    <ul class="flex flex-wrap space-x-2 space-y-2">
                      {{ for page of pageCats }}
                        <li>
                          <a
                            href="{{ page.url }}"
                            class="rounded-md bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-50 dark:bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-200 px-2 py-1 text-xs font-medium text-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-900 dark:text-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-900 ring-1 ring-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-500/10 dark:ring-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-500/30 ring-inset hover:bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-100 no-underline whitespace-nowrap"
                          >{{ page.category }}</a>
                        </li>
                      {{ /for }}
                    </ul>
                  </nav>
                </div>
              {{ /if }}

              {{ set pageTags = search.pages(`type=tag lang=${lang}`, "tag") }}
              {{ set tagLimit = 16 }}
              {{ if pageTags.length }}
                {{# Authors have generated well over a hundred distinct tags,
                    most used exactly once, so the full list buried everything
                    below it on the page. Only the first `tagLimit` are shown;
                    the rest sit behind a disclosure.

                    <details>/<summary> rather than Alpine on purpose: it needs
                    no JavaScript, is keyboard and screen-reader accessible
                    with no ARIA of our own, and cannot flash open before a
                    script initialises. (The `x-cloak` used elsewhere in this
                    codebase has no backing CSS and is inert — see issue #357.) #}}
                <div class="text-zinc-500 ml-1 mt-4">
                  <nav class="">
                    <h2>{{ i18n.search.tags }}:</h2>
                    <ul class="flex flex-wrap space-x-2 space-y-2">
                      {{ for page of pageTags.slice(0, tagLimit) }}
                        <li>
                          <a
                            href="{{ page.url }}"
                            class="rounded-md bg-zinc-50 dark:bg-zinc-700 px-2 py-1 text-xs font-medium text-zinc-900 dark:text-zinc-50 ring-1 ring-zinc-500/10 ring-inset hover:bg-zinc-100 dark:hover:bg-zinc-500 no-underline whitespace-nowrap"
                          >{{ page.tag }}</a>
                        </li>
                      {{ /for }}
                    </ul>

                    {{ if pageTags.length > tagLimit }}
                      <details class="tag-disclosure mt-2">
                        <summary
                          class="inline-flex items-center gap-1.5 cursor-pointer rounded-md px-2 py-1 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-50 select-none"
                        >
                          {{# Both labels are rendered; CSS swaps them on
                              [open] so the control does not need script. #}}
                          <span class="tag-disclosure-more">{{ i18n.archive.show_all_tags }} ({{ pageTags.length }})</span>
                          <span class="tag-disclosure-less">{{ i18n.archive.show_fewer_tags }}</span>
                        </summary>
                        <ul class="flex flex-wrap space-x-2 space-y-2 mt-2">
                          {{ for page of pageTags.slice(tagLimit) }}
                            <li>
                              <a
                                href="{{ page.url }}"
                                class="rounded-md bg-zinc-50 dark:bg-zinc-700 px-2 py-1 text-xs font-medium text-zinc-900 dark:text-zinc-50 ring-1 ring-zinc-500/10 ring-inset hover:bg-zinc-100 dark:hover:bg-zinc-500 no-underline whitespace-nowrap"
                              >{{ page.tag }}</a>
                            </li>
                          {{ /for }}
                        </ul>
                      </details>
                    {{ /if }}
                  </nav>
                </div>
              {{ /if }}
            {{ /if }}
          </header>

          <div class="mt-16 sm:mt-20">
            <div
              class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40"
            >
              <div class="flex max-w-3xl flex-col space-y-16">
                {{ include "templates/post-list.vto" { postslist: results } }}

                {{ if pagination.totalPages !== 1 }}
                  {{# Numbered pager. `pager` comes from the generator, which
                      is the only place that knows how a page number becomes a
                      URL; it carries the first page, the last, the current one
                      and its neighbours, with gap markers where a run was
                      skipped.

                      The markup used to be three bare list items styled by
                      `.pagination` classes that no stylesheet in this repo
                      ever defined, so it rendered as an unstyled list. #}}
                  <nav
                    class="mt-4 border-t border-zinc-100 pt-8 dark:border-zinc-700/40"
                    aria-label="{{ i18n.nav.pagination }}"
                  >
                    <p class="sr-only">
                      {{ i18n.nav.page }} {{ pagination.page }} / {{ pagination.totalPages }}
                    </p>
                    <ul class="flex flex-wrap items-center justify-center gap-2">
                      <li>
                        {{ if pagination.previous }}
                          <a
                            href="{{ pagination.previous }}"
                            rel="prev"
                            class="inline-flex h-10 items-center gap-1 rounded-lg px-3 text-sm font-medium text-zinc-700 ring-1 ring-zinc-900/10 ring-inset transition hover:bg-zinc-50 hover:text-zinc-950 dark:text-zinc-200 dark:ring-white/10 dark:hover:bg-zinc-800 dark:hover:text-white"
                          >{{ i18n.nav.previous }}</a>
                        {{ else }}
                          <span
                            class="inline-flex h-10 items-center gap-1 rounded-lg px-3 text-sm font-medium text-zinc-300 ring-1 ring-zinc-900/5 ring-inset dark:text-zinc-600 dark:ring-white/5"
                            aria-hidden="true"
                          >{{ i18n.nav.previous }}</span>
                        {{ /if }}
                      </li>

                      {{ for item of pager }}
                        <li>
                          {{ if item.gap }}
                            <span
                              class="inline-flex h-10 w-6 items-center justify-center text-sm text-zinc-400 dark:text-zinc-500"
                              aria-hidden="true"
                            >…</span>
                          {{ else if item.current }}
                            {{# A span, not a link: the current page is not
                                somewhere to navigate to. #}}
                            <span
                              aria-current="page"
                              class="inline-flex h-10 min-w-10 items-center justify-center rounded-lg bg-esoliablue-900 px-3 text-sm font-semibold text-white dark:bg-esoliablue-600"
                            >{{ item.n }}</span>
                          {{ else }}
                            <a
                              href="{{ item.url }}"
                              aria-label="{{ i18n.nav.page }} {{ item.n }}"
                              class="inline-flex h-10 min-w-10 items-center justify-center rounded-lg px-3 text-sm font-medium text-zinc-700 ring-1 ring-zinc-900/10 ring-inset transition hover:bg-zinc-50 hover:text-zinc-950 dark:text-zinc-200 dark:ring-white/10 dark:hover:bg-zinc-800 dark:hover:text-white"
                            >{{ item.n }}</a>
                          {{ /if }}
                        </li>
                      {{ /for }}

                      <li>
                        {{ if pagination.next }}
                          <a
                            href="{{ pagination.next }}"
                            rel="next"
                            class="inline-flex h-10 items-center gap-1 rounded-lg px-3 text-sm font-medium text-zinc-700 ring-1 ring-zinc-900/10 ring-inset transition hover:bg-zinc-50 hover:text-zinc-950 dark:text-zinc-200 dark:ring-white/10 dark:hover:bg-zinc-800 dark:hover:text-white"
                          >{{ i18n.nav.next }}</a>
                        {{ else }}
                          <span
                            class="inline-flex h-10 items-center gap-1 rounded-lg px-3 text-sm font-medium text-zinc-300 ring-1 ring-zinc-900/5 ring-inset dark:text-zinc-600 dark:ring-white/5"
                            aria-hidden="true"
                          >{{ i18n.nav.next }}</span>
                        {{ /if }}
                      </li>
                    </ul>
                  </nav>
                {{ /if }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<!-- ===== archive.vto LAYOUT END ===== -->
