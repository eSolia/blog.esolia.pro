{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "ab2ac8ca4000c79ae4a66377276585be",
  "name": "blog-esolia-pro",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  // Serve this Worker only on blog.esolia.pro (and via the BLOG service binding
  // from esolia-2025). `workers_dev` defaults to true, which would publish a
  // stable blog-esolia-pro.esolia.workers.dev hostname in Cloudflare's own zone
  // — outside our zone's WAF, scanner-pattern blocks and rate limits, and
  // outside any Cloudflare Access application, which binds to one hostname.
  // It also gives search engines a second host for the same content, the
  // duplicate-indexing problem docs/blog-url-consolidation-plan.md is fixing.
  // Disabling the route in the dashboard is not durable: Cloudflare re-enables
  // it on the next `wrangler deploy` unless it is false here.
  // `preview_urls` has matched `workers_dev` when unset since wrangler v4.44.0;
  // set explicitly so the intent survives a wrangler version change.
  // Rule: devkit .claude/shared-rules/cloudflare-cost-guards.md, "Wrangler
  // configuration" item 4.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker before serving assets for API routes. Without this, a form
    // POST carrying Sec-Fetch-Mode: navigate would be served the 404 asset
    // instead of invoking the newsletter handler.
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  // Per-IP rate limit for the newsletter endpoint: 5 requests / 60s.
  "ratelimits": [
    {
      "name": "NEWSLETTER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
