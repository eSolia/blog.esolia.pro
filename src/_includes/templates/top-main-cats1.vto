<!-- ===== top-main-cats1.vto TEMPLATE START ===== -->
{{
  set pageCats = search.pages(`type=category lang=${lang}`, "category=desc-locale")
}}
{{ if pageCats.length }}
  <div
  id="top-main-cats"
  class="flex rounded-2xl border border-outline-variant bg-surface-container-low p-3"
>
  <nav aria-label="{{ i18n.search.by_category }}">
    <ul class="flex flex-wrap gap-2">
        {{ for page of pageCats }}
          <li>
            <a
              href="{{ page.url }}"
              class="m3-chip inline-flex items-center bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-50 dark:bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-200 px-3 py-1.5 text-xs font-medium text-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-900 dark:text-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-900 ring-1 ring-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-500/15 dark:ring-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-500/30 ring-inset hover:bg-{{ if page.color }}{{ page.color }}{{ else }}zinc{{ /if }}-100 no-underline whitespace-nowrap"
            >{{ page.category }}</a>
          </li>
        {{ /for }}
      </ul>
  </nav>
</div>
{{ /if }}
<!-- ===== top-main-cats1.vto TEMPLATE END ===== -->
